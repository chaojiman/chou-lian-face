.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 36rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f7f4ee;
}

/* ---------- 标题 ---------- */
.hero {
  width: 100%;
  margin-bottom: 28rpx;
  text-align: center;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #14110f;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a8175;
}

/* ---------- 画布 ---------- */
.stage {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  border: 3rpx solid #14110f;
  box-shadow: 8rpx 8rpx 0 0 #14110f;
}

.face-canvas {
  display: block;
}

.busy-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(247, 244, 238, 0.82);
}

.busy-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #14110f;
  animation: pulse 0.7s ease-in-out infinite alternate;
}

.busy-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #14110f;
}

@keyframes pulse {
  from { transform: scale(0.6); opacity: 0.4; }
  to   { transform: scale(1.3); opacity: 1; }
}

/* ---------- 取色结果 ---------- */
.swatches {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #e2dbcf;
}

.swatch {
  display: flex;
  align-items: center;
  margin-right: 22rpx;
}

.swatch-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  border: 2rpx solid rgba(20, 17, 15, 0.18);
}

.swatch-name {
  font-size: 22rpx;
  color: #6d655a;
}

.swatch-clear {
  font-size: 22rpx;
  color: #b04a3f;
  padding: 4rpx 10rpx;
  border-left: 2rpx solid #e2dbcf;
  margin-left: 2rpx;
  padding-left: 22rpx;
}

.swatch-clear-hover {
  opacity: 0.55;
}

/* ---------- 按钮 ---------- */
.actions {
  width: 100%;
  display: flex;
  margin-top: 40rpx;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  margin: 0;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border-radius: 18rpx;
  border: 3rpx solid #14110f;
  transition: all 0.12s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #14110f;
  color: #f7f4ee;
  box-shadow: 6rpx 6rpx 0 0 #c9c0b2;
}

.btn-ghost {
  background: #ffffff;
  color: #14110f;
  box-shadow: 6rpx 6rpx 0 0 #14110f;
}

.btn-save {
  width: 100%;
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  background: #ffffff;
  color: #14110f;
  border: 3rpx dashed #14110f;
  box-shadow: none;
}

.btn-hover {
  transform: translate(3rpx, 3rpx);
  box-shadow: 2rpx 2rpx 0 0 #14110f;
  opacity: 0.9;
}

/* ---------- 页脚 ---------- */
.footer {
  margin-top: auto;
  padding-top: 48rpx;
  text-align: center;
  font-size: 21rpx;
  color: #a89f92;
}
